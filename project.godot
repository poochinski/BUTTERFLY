; Engine configuration file.
; Open this folder in Godot 4.7+ and press F5 to play.

config_version=5

[application]

config/name="Meadowlight"
config/description="A cozy butterfly-catching game. Wander a painterly meadow at sunset, sneak up on butterflies and fill your field journal."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=64

[shader_globals]

player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wind_params={
"type": "vec4",
"value": Vector4(1, 0.4, 0.5, 0)
}
water_level={
"type": "float",
"value": -100.0
}
height_tex={
"type": "sampler2D",
"value": ""
}
mask_tex={
"type": "sampler2D",
"value": ""
}
noise_tex={
"type": "sampler2D",
"value": ""
}
